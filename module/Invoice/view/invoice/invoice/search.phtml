    <form method="get" action="<?= $this->url('invoice-search') ?>">
        <div class="search-box">
            <input type="text" name="q" placeholder="Ex: Tech Store, INV-2026-001..." value="<?= $this->escapeHtml($query ?? '') ?>" autofocus>
            <button type="submit" class="btn-primary">Rechercher</button>
        </div>
    </form>

    <?php if (!empty($error)): ?>
        <div class="erp-error">⚠️ <?= $this->escapeHtml($error) ?></div>
    <?php endif; ?>

    <?php if (isset($result)): ?>

        <?php if (!empty($result['natural_response'])): ?>
            <div class="ai-response">
                🤖 <?= $this->escapeHtml($result['natural_response']) ?>
            </div>
        <?php endif; ?>

        <?php if (empty($result['results'])): ?>
            <div class="erp-table erp-empty">
                Aucun résultat pour « <?= $this->escapeHtml($query) ?> ».
            </div>
        <?php else: ?>
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>N° Facture</th>
                        <th>Fournisseur</th>
                        <th>Client</th>
                        <th>Montant</th>
                        <th>Pertinence</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($result['results'] as $r): ?>
                        <tr>
                            <td><?= $this->escapeHtml($r['invoice_number'] ?? '—') ?></td>
                            <td><?= $this->escapeHtml($r['vendor_name'] ?? '—') ?></td>
                            <td><?= $this->escapeHtml($r['client_name'] ?? '—') ?></td>
                            <td><?= $this->escapeHtml((string) ($r['total_amount'] ?? '—')) ?> <?= $this->escapeHtml($r['currency'] ?? '') ?></td>
                            <td><span class="badge"><?= $this->escapeHtml((string) ($r['_score'] ?? '')) ?>%</span></td>
                            <td><a href="<?= $this->url('invoice-view', ['id' => $r['id']]) ?>">Voir</a></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>

    <?php endif; ?>

