                    <th></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($invoices as $facture): ?>
                    <tr>
                        <td><?= $this->escapeHtml($facture['invoice_number'] ?? '—') ?></td>
                        <td><?= $this->escapeHtml($facture['vendor_name'] ?? '—') ?></td>
                        <td><?= $this->escapeHtml($facture['client_name'] ?? '—') ?></td>
                        <td><?= $this->escapeHtml((string) ($facture['total_amount'] ?? '—')) ?> <?= $this->escapeHtml($facture['currency'] ?? '') ?></td>
                        <td><?= $this->escapeHtml($facture['invoice_date'] ?? '—') ?></td>
                        <td><a href="<?= $this->url('invoice-view', ['id' => $facture['id']]) ?>">Voir</a></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>

        <div class="pagination">
            <?php if ($page > 1): ?>
                <a href="<?= $this->url('invoice-history') ?>?page=<?= $page - 1 ?>">← Précédent</a>
