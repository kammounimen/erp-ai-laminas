<script>
/* =========================================================
   0) URL de base de l'API Python (FastAPI)
   À adapter si le port ou le domaine change (ex: en production).
   ========================================================= */
const PYTHON_API_BASE = 'http://127.0.0.1:8001';

/* =========================================================
   1) Ajout dynamique d'une ligne d'article
   ========================================================= */
function addItemRow(){
    const tbody = document.getElementById('items-body');

    const row = document.createElement('tr');
    row.innerHTML = `
        <td><input name="item_description[]"></td>
        <td><input name="item_quantity[]"></td>
        <td><input name="item_unit_price[]"></td>
        <td><input name="item_total_price[]"></td>
        <td>
            <input type="hidden" name="item_product_id[]" value="">
            <input type="hidden" name="item_new_product[]" value="0">
            <span class="product-status is-pending">
                <span class="dot"></span> En attente
            </span>
        </td>
    `;

    tbody.appendChild(row);
}

/* =========================================================
   2) Aides : statut visuel par ligne + score
   ========================================================= */
function setRowStatus(row, state, label) {
    const span = row.querySelector('.product-status');
    span.className = 'product-status ' + state;

    if (state === 'is-checking') {
        span.innerHTML = '<span class="spin"></span> ' + label;
    } else if (state === 'is-pending-choice') {
        span.innerHTML = '<span class="dot"></span> ' + label;
    } else {
        span.innerHTML = '<span class="dot"></span> ' + label;
    }
}

function scoreClass(score) {
    if (score >= 90) return 'score-high';
    if (score >= 75) return 'score-mid';
    return 'score-low';
}

/* =========================================================
   3) Modale de sélection produit
   ========================================================= */
const overlay        = document.getElementById('product-modal-overlay');
const detectedNameEl = document.getElementById('modal-detected-name');
const sectionLabelEl = document.getElementById('modal-section-label');
const listEl          = document.getElementById('modal-suggestion-list');
const newOptionEl    = document.getElementById('modal-new-product-option');
const confirmBtn      = document.getElementById('modal-confirm-btn');
const cancelBtn       = document.getElementById('modal-cancel-btn');

let modalResolver = null; // résout la Promise en attente quand l'utilisateur choisit

function openProductModal(description, suggestions) {
    detectedNameEl.textContent = description;
    listEl.innerHTML = '';
    confirmBtn.disabled = true;
    newOptionEl.querySelector('input').checked = false;
    newOptionEl.classList.remove('is-selected');

    if (suggestions && suggestions.length > 0) {
        sectionLabelEl.textContent = 'Produits similaires trouvés';

        suggestions.forEach((s, idx) => {
            const label = document.createElement('label');
            label.className = 'suggestion-option';
            label.innerHTML = `
                <input type="radio" name="modal-product-choice" value="${s.id}">
                <span class="opt-text">
                    <span class="opt-name">${escapeHtml(s.name)}</span>
                    <span class="opt-sub">Produit existant #${s.id}</span>
                </span>
                <span class="score-pill ${scoreClass(s.score)}">${s.score}%</span>
            `;
            listEl.appendChild(label);
        });
    } else {
        sectionLabelEl.textContent = 'Aucun produit similaire trouvé';
        const empty = document.createElement('div');
        empty.className = 'empty-suggestions';
        empty.textContent = 'Ce produit semble nouveau dans le catalogue.';
        listEl.appendChild(empty);
    }

    // Gère la sélection visuelle (radio -> highlight + activation du bouton)
    overlay.querySelectorAll('input[name="modal-product-choice"]').forEach(radio => {
        radio.addEventListener('change', onModalChoiceChange);
    });

    overlay.classList.add('is-open');

    return new Promise((resolve) => {
        modalResolver = resolve;
    });
}

function onModalChoiceChange() {
    overlay.querySelectorAll('.suggestion-option').forEach(opt => opt.classList.remove('is-selected'));
    const checked = overlay.querySelector('input[name="modal-product-choice"]:checked');
    if (checked) {
        checked.closest('.suggestion-option').classList.add('is-selected');
        confirmBtn.disabled = false;
    }
}

function closeProductModal() {
    overlay.classList.remove('is-open');
    overlay.querySelectorAll('input[name="modal-product-choice"]').forEach(radio => {
        radio.removeEventListener('change', onModalChoiceChange);
    });
}

confirmBtn.addEventListener('click', () => {
    const checked = overlay.querySelector('input[name="modal-product-choice"]:checked');
    if (!checked || !modalResolver) return;

    const value = checked.value;
    closeProductModal();

    if (value === '__new__') {
        modalResolver({ productId: null, isNew: true });
    } else {
        modalResolver({ productId: parseInt(value, 10), isNew: false });
    }
    modalResolver = null;
});

cancelBtn.addEventListener('click', () => {
    closeProductModal();
    if (modalResolver) {
        modalResolver({ cancelled: true });
        modalResolver = null;
    }
});

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
}

/* =========================================================
   4) Validation de chaque article via /api/products/check
   ========================================================= */
async function validateProducts() {
    const rows = Array.from(document.querySelectorAll('#items-body tr'));
    const banner = document.getElementById('validating-banner');
    const bannerText = document.getElementById('validating-banner-text');
    const confirmButton = document.getElementById('confirm-btn');

    confirmButton.disabled = true;
    banner.classList.add('is-active');

    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const descInput = row.querySelector('input[name="item_description[]"]');
        const description = (descInput.value || '').trim();

        if (description === '') {
            continue; // ligne vide, on l'ignore (le contrôleur la filtre déjà)
        }

        bannerText.textContent = `Vérification "${description}" (${i + 1}/${rows.length})…`;
        setRowStatus(row, 'is-checking', 'Vérification…');

        let result;
        try {
            const response = await fetch(PYTHON_API_BASE + '/api/products/check', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description })
            });

            if (!response.ok) {
                throw new Error('Réponse API invalide (' + response.status + ')');
            }

            result = await response.json();
        } catch (err) {
            banner.classList.remove('is-active');
            confirmButton.disabled = false;
            setRowStatus(row, 'is-pending', 'En attente');
            alert("Impossible de vérifier le produit \"" + description + "\" : " + err.message);
            return; // on stoppe tout, l'utilisateur peut réessayer
        }

        const productIdField = row.querySelector('input[name="item_product_id[]"]');
        const newProductField = row.querySelector('input[name="item_new_product[]"]');

        if (result.exists) {
            productIdField.value = result.product_id;
            newProductField.value = '0';
            setRowStatus(row, 'is-matched', result.product_name || 'Produit reconnu');
            continue;
        }

        // Produit inconnu : on ouvre la modale et on attend le choix utilisateur
        banner.classList.remove('is-active');
        setRowStatus(row, 'is-pending-choice', 'Choix requis');

        const choice = await openProductModal(description, result.suggestions || []);

        if (choice.cancelled) {
            confirmButton.disabled = false;
            setRowStatus(row, 'is-pending', 'En attente');
            return; // l'utilisateur a annulé : on arrête toute la validation
        }

        if (choice.isNew) {
            productIdField.value = '';
            newProductField.value = '1';
            setRowStatus(row, 'is-new', 'Nouveau produit');
        } else {
            productIdField.value = choice.productId;
            newProductField.value = '0';
            const chosenName = (result.suggestions || []).find(s => s.id === choice.productId);
            setRowStatus(row, 'is-matched', chosenName ? chosenName.name : 'Produit sélectionné');
        }

        banner.classList.add('is-active');
    }

    banner.classList.remove('is-active');
    bannerText.textContent = 'Tous les produits sont validés. Enregistrement…';
    banner.classList.add('is-active');

    // Toutes les lignes sont validées : on soumet réellement le formulaire
    document.getElementById('invoice-form').submit();
}
</script>