<script>
    function addItemRow() {
        const tbody = document.getElementById('items-body');
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><input type="text" name="item_description[]"></td>
            <td><input type="number" step="0.01" name="item_quantity[]"></td>
            <td><input type="number" step="0.01" name="item_unit_price[]"></td>
            <td><input type="number" step="0.01" name="item_total_price[]"></td>
        `;
        tbody.appendChild(row);
    }
</script>
