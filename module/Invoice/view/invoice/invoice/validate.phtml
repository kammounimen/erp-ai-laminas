<script>
function addItemRow(){
    const tbody = document.getElementById('items-body');

    const row = document.createElement('tr');
    row.innerHTML = `
        <td><input name="item_description[]"></td>
        <td><input name="item_quantity[]"></td>
        <td><input name="item_unit_price[]"></td>
        <td><input name="item_total_price[]"></td>
    `;

    tbody.appendChild(row);
}
</script>